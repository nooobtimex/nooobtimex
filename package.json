{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"build": "bun run icons:check && bun run typecheck && next build && bun run links:check && bun run seo:check && bun run bundle:check",
		"bundle:check": "bun run scripts/bundle/check.ts",
		"dev": "next dev -p 1000",
		"icons:check": "bun run scripts/icons/check.ts",
		"icons:generate": "bun run scripts/icons/generate.ts",
		"links:check": "bun run scripts/links/check.ts",
		"links:external": "bun run scripts/links/external.ts",
		"llms:generate": "bun run scripts/llms/generate.ts",
		"images:optimize": "bun run scripts/images/optimize.ts",
		"lint": "eslint . --fix && prettier . --write",
		"readme:assets": "bun run scripts/readme/generate.ts",
		"seo:check": "bun run scripts/seo/check.ts",
		"start": "next start -p 1000",
		"typecheck": "next typegen && tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@iconify/react": "^6.0.2",
		"@iconify/utils": "^3.1.7",
		"@next/third-parties": "^16.3.8",
		"@tailwindcss/postcss": "^4.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"framer-motion": "^14.0.0",
		"lucide-react": "^1.52.0",
		"next": "^16.3.8",
		"next-themes": "^0.4.6",
		"qrcode.react": "^4.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.5",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@iconify-json/carbon": "^1.2.28",
		"@iconify-json/logos": "^1.2.15",
		"@iconify-json/material-symbols": "^1.2.94",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/simple-icons": "^1.2.99",
		"@iconify-json/skill-icons": "^1.2.4",
		"@next/eslint-plugin-next": "^16.3.8",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "10.12.0",
		"eslint-config-next": "^16.3.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"postcss": "^8.5.29",
		"prettier": "3.9.9",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn": "^4.21.2",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1"
	}
}
